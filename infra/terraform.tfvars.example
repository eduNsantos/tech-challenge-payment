# Copie para terraform.tfvars e preencha os valores reais
# NUNCA commite terraform.tfvars — ele esta no .gitignore

mp_access_token      = "APP_USR-..."    # Painel MP: Configuracoes > Credenciais
mp_webhook_secret    = "..."            # Painel MP: Configuracoes > Notificacoes > Chave secreta
app_notification_url = "https://<app-publico>/api/payment/notification"   # endpoint do application que recebe o link de pagamento (Step ③)

# Opcionais — back_urls do Checkout Pro (HTTPS com DNS; localhost nao e aceito pelo MP)
# checkout_back_url_success = "https://app.example.com/checkout/success"
# checkout_back_url_pending = "https://app.example.com/checkout/pending"
# checkout_back_url_failure = "https://app.example.com/checkout/failure"
