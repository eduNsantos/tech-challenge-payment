{
  "name": "Payment Service — SAGA",
  "description": "Pagamentos (Step Functions + Mercado Pago): funil, aprovação e saúde das Lambdas",
  "permissions": "PUBLIC_READ_WRITE",
  "pages": [
    {
      "name": "Pagamentos",
      "description": null,
      "widgets": [
        {
          "title": "Pedidos recebidos",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 3,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8497993
                ],
                "query": "SELECT uniqueCount(orderId) AS 'Pedidos' FROM PaymentSaga WHERE status = 'QUEUED' SINCE 1 day ago COMPARE WITH 1 day ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Pagamentos aprovados",
          "layout": {
            "column": 4,
            "row": 1,
            "width": 3,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8497993
                ],
                "query": "SELECT uniqueCount(orderId) AS 'Pagos' FROM PaymentSaga WHERE status = 'PAID' SINCE 1 day ago COMPARE WITH 1 day ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Taxa de aprovação",
          "layout": {
            "column": 7,
            "row": 1,
            "width": 3,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8497993
                ],
                "query": "SELECT percentage(uniqueCount(orderId), WHERE status = 'PAID') AS 'Aprovação' FROM PaymentSaga WHERE status IN ('PAID','REJECTED','EXPIRED') SINCE 1 day ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Valor pago (R$)",
          "layout": {
            "column": 10,
            "row": 1,
            "width": 3,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8497993
                ],
                "query": "SELECT sum(amountCents) / 100 AS 'R$' FROM PaymentSaga WHERE status = 'PAID' SINCE 1 day ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Funil da SAGA",
          "layout": {
            "column": 1,
            "row": 4,
            "width": 6,
            "height": 4
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.funnel"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8497993
                ],
                "query": "SELECT funnel(orderId, WHERE status = 'QUEUED' AS '1. Recebido', WHERE status = 'PENDING' AS '2. Registrado', WHERE status = 'LINK_CREATED' AS '3. Link gerado', WHERE status = 'WAITING_PAYMENT' AS '4. Aguardando', WHERE status = 'PAID' AS '5. Pago') FROM PaymentSaga SINCE 1 day ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Eventos por status",
          "layout": {
            "column": 7,
            "row": 4,
            "width": 6,
            "height": 4
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8497993
                ],
                "query": "SELECT count(*) FROM PaymentSaga FACET status TIMESERIES AUTO SINCE 1 day ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Tempo até o resultado (s)",
          "layout": {
            "column": 1,
            "row": 8,
            "width": 4,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.bar"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8497993
                ],
                "query": "SELECT percentile(durationSeconds, 50, 95) FROM PaymentSaga WHERE status IN ('PAID','REJECTED','EXPIRED') FACET status SINCE 1 week ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Falhas e expirações",
          "layout": {
            "column": 5,
            "row": 8,
            "width": 4,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
