              {
                "accountIds": [
                  8497993
                ],
                "query": "SELECT count(*) FROM PaymentSaga WHERE status IN ('LINK_ERROR','WEBHOOK_INVALID_SIGNATURE','REJECTED','EXPIRED') FACET status SINCE 1 day ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Meio de pagamento",
          "layout": {
            "column": 9,
            "row": 8,
            "width": 4,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.pie"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8497993
                ],
                "query": "SELECT count(*) FROM PaymentSaga WHERE status = 'PAID' FACET paymentMethod SINCE 1 week ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Últimos eventos",
          "layout": {
            "column": 1,
            "row": 11,
            "width": 12,
            "height": 4
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8497993
                ],
                "query": "SELECT timestamp, orderId, step, status, amountCents / 100 AS 'R$', mpStatusDetail FROM PaymentSaga SINCE 1 day ago LIMIT 100"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        }
      ]
    },
